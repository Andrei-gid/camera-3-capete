{
  // Cloudflare Workers deploy config (used by `npx wrangler deploy`).
  // Static site from Vite's ./dist; /api/* and /media/* go to worker/index.ts.
  "name": "camera-3-capete",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  // Site content, uploaded photos/videos and orders. No "id" on purpose:
  // wrangler creates the namespace on first deploy and keeps reusing it.
  "kv_namespaces": [{ "binding": "KV" }],
  // Own domain: added later (Settings → Domains & Routes or "routes" here).
  // Until then the site runs on camera-3-capete.<account>.workers.dev
  // Not secret: the Telegram chat that receives orders. The bot token stays a
  // Secret in the dashboard (Settings → Variables and Secrets).
  "vars": { "TELEGRAM_CHAT_ID": "270443525" },
  // Keep variables added in the dashboard when deploying from GitHub.
  "keep_vars": true,
  "observability": { "enabled": true }
}
